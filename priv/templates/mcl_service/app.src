    {env, []},
    {modules, []},
    {licenses, [<%#proprietary%>"Proprietary"<%/proprietary%><%^proprietary%>"Apache-2.0"<%/proprietary%>]},
    {links, [{"GitHub", "https://github.com/<%org%>/<%repo%>"}]}
]}.
