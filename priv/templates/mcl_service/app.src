{{=<% %>=}}{application, <%name%>, [
    {description, "<%desc%>"},
    {vsn, "0.1.0"},
    {registered, [<%name%>_sup]},
    {mod, {<%name%>_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om<%#store%>,
        %% This service's own event store (<%name%>_app opens it).
        reckon_db,
        evoq,
        reckon_evoq<%/store%>
    ]},
    {env, []},
    {modules, []},
    {licenses, [<%#proprietary%>"Proprietary"<%/proprietary%><%^proprietary%>"Apache-2.0"<%/proprietary%>]},
    {links, [{"GitHub", "https://github.com/<%org%>/<%repo%>"}]}
]}.
